# Yerel kaynak rehberler: veritabanına henüz aktarılmadı, GitHub'a gönderilmez.
/resources/
# Sahiplik düzeltmesinde korunan boş Git metadata klasörü.
/.git.del/

# Gizli ortam ve paket yöneticisi kimlik bilgileri
.env
.env.*
!.env.example
auth.json

# Bağımlılıklar
vendor/
node_modules/

# Laravel / Vite tarafından üretilen dosyalar
/app/public/build/
/app/public/hot
/app/public/storage
/app/bootstrap/cache/*
!/app/bootstrap/cache/.gitignore
/app/storage/*.key
/app/storage/app/private/*
!/app/storage/app/private/.gitignore
/app/storage/app/public/*
!/app/storage/app/public/.gitignore
/app/storage/framework/cache/*
!/app/storage/framework/cache/.gitignore
/app/storage/framework/sessions/*
!/app/storage/framework/sessions/.gitignore
/app/storage/framework/testing/*
!/app/storage/framework/testing/.gitignore
/app/storage/framework/views/*
!/app/storage/framework/views/.gitignore
/app/storage/logs/*
!/app/storage/logs/.gitignore
/app/database/*.sqlite
/app/database/*.sqlite-*

# Test ve analiz çıktıları
.phpunit.cache/
.phpunit.result.cache
/app/coverage/
/app/.phpstan.cache/

# Editör: ortak proje ayarları sürüm kontrolünde tutulur.
.idea/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json

# İşletim sistemi ve geçici dosyalar
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.swp
