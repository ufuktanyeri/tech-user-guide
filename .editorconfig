root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,js,ts,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Kaynak rehberlerin mevcut dosya biçimi korunur.
[resources/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = false
trim_trailing_whitespace = false
